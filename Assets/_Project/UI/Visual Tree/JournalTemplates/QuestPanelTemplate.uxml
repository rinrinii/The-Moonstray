            <ui:Label text="" name="QuestSubmitStatus" style="color: rgb(90, 42, 36); -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); font-size: 27%; padding-left: 5%; margin-top: 6px; white-space: normal; width: 90%; flex-shrink: 0;"/>
            <ui:Button text="Submit Quest" name="SubmitQuestButton" class="journalButton" style="margin-top: 4px; width: 150px; height: 42px; align-self: flex-end; margin-right: 8%; flex-shrink: 0;"/>
