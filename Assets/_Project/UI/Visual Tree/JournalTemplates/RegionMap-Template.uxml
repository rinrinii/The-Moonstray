<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="MapPanel" style="flex-grow: 0; background-image: none; width: 80%; max-width: none; height: 77%; background-color: rgb(108, 108, 108);">
        <ui:VisualElement name="MapImage" style="flex-grow: 1; width: 100%; height: 100%;">
            <ui:Image name="PlayerIcon" style="background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/player-icon.png?fileID=2800000&amp;guid=8e0e1560d5445c8428024ca0559b1a0c&amp;type=3#player-icon&quot;); position: absolute; width: 82px; height: 66px;"/>
        </ui:VisualElement>
        <ui:Label text="Region Title" name="regionTitle-Label" style="top: 3%; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 64px; position: absolute; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; padding-left: 25px; padding-top: 15px; padding-bottom: 15px; padding-right: 25px; align-self: center;"/>
        <ui:GroupBox name="Legend-Group" style="width: 352px; height: 400px; left: auto; right: 2%; position: absolute; bottom: 4%; flex-direction: row;">
            <ui:VisualElement name="icon-column" style="flex-grow: 1; width: 7%; left: auto; position: relative; height: 100%; align-self: center; align-items: stretch;">
                <ui:Image name="player-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/player-icon.png?fileID=2800000&amp;guid=8e0e1560d5445c8428024ca0559b1a0c&amp;type=3#player-icon&quot;); margin-bottom: 15px;"/>
                <ui:Image name="npc-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/npc-icon.png?fileID=2800000&amp;guid=8e605f25b8306a54c869f8bbe91245c3&amp;type=3#npc-icon&quot;); margin-bottom: 15px; background-size: 75% 100%;"/>
                <ui:Image name="resource-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/resource-icon.png?fileID=2800000&amp;guid=6e3b5776acebc0d4982b71f6d27caa63&amp;type=3#resource-icon&quot;); margin-bottom: 15px; background-size: 75% 100%;"/>
                <ui:Image name="quest-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/quest-icon.png?fileID=2800000&amp;guid=8c787d0391e8e0c4b856f3059c66ca92&amp;type=3#quest-icon&quot;); margin-bottom: 15px; background-size: 75% 100%;"/>
                <ui:Image name="note-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/note-icon.png?fileID=2800000&amp;guid=d4e7380aed7dc8044a6252937120a730&amp;type=3#note-icon&quot;); margin-bottom: 15px; background-size: 75% 85%;"/>
                <ui:Image name="blocked-icon" style="width: 100%; height: 57px; align-self: center; background-image: url(&quot;project://database/Assets/_Project/UI/Images/Map/blocked-icon.png?fileID=2800000&amp;guid=93269c589118d744e85fcf58b973b50c&amp;type=3#blocked-icon&quot;); margin-bottom: 15px; background-size: 80% 68%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="label-column" style="flex-grow: 1; width: 75%; padding-left: 20px;">
                <ui:Label text="Player" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
                <ui:Label text="NPC" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
                <ui:Label text="Resources" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
                <ui:Label text="Quest" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
                <ui:Label text="Note" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
                <ui:Label text="Blocked Path" style="-unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255); font-size: 38%; margin-bottom: 15px;"/>
            </ui:VisualElement>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
