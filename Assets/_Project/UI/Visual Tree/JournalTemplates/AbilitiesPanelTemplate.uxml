        </ui:VisualElement>
        <ui:VisualElement name="RightSection" style="flex-grow: 0; width: 50%; align-items: flex-start; margin-top: 0%; margin-bottom: 0%; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; margin-right: 0%; margin-left: 0%; flex-direction: column; justify-content: flex-start; flex-wrap: nowrap; min-height: 100%; height: 100%;">
            <ui:Label text="Ability Name" name="AbilityNameLabel" style="font-size: 50%; color: rgb(41, 39, 37); -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 3%; padding-right: 40%; padding-bottom: 2%; padding-left: 40%; top: auto; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0%; border-top-right-radius: 0%; border-bottom-right-radius: 0%; border-bottom-left-radius: 0%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: flex-start; -unity-text-align: upper-center;"/>
            <ui:VisualElement name="AbilityInfoContainer" style="flex-grow: 1; width: 100%; flex-wrap: wrap;">
                <ui:VisualElement name="AbilityDescriptionContainer" style="flex-grow: 1; max-width: 100%; width: 100%; height: 100%; max-height: 25%;">
                    <ui:Label text="Nothing here..." name="AbilityDescription" style="color: rgb(41, 39, 37); -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); font-size: 29%; padding-left: 0%; margin-top: 2px; white-space: normal;"/>
                </ui:VisualElement>
