                <ui:Image name="Divider" style="background-image: url(&quot;project://database/Assets/_Project/UI/Images/HUD/divider-line.png?fileID=21300000&amp;guid=9bf56196a7c6c654eb64dc72d8e01d46&amp;type=3#divider-line&quot;); height: 2%; margin-top: 10px; margin-bottom: 10px;"/>
