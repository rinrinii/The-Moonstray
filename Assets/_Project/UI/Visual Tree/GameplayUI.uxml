    <ui:VisualElement name="Root" style="flex-grow: 1; display: flex;">
        <ui:VisualElement name="HPOverlay" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_Project/UI/Images/HUD/hp-low-overlay.png?fileID=2800000&amp;guid=9940a86be6b365441b20c8dabe6c7310&amp;type=3#hp-low-overlay&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); opacity: 0; position: absolute; top: 0; left: 0; right: 0; bottom: 0;"/>
        <ui:VisualElement name="HUDContainer" style="flex-grow: 1; position: absolute; align-items: center; align-content: flex-start; top: -3px; left: 0; bottom: 4px; right: 0; display: flex;">
            <ui:VisualElement name="ObjectivesHUDGroup" style="position: absolute; left: 2%; top: 3%; width: 33%; max-width: 640px; min-width: 400px; flex-direction: column; align-items: stretch;">
                <ui:VisualElement name="ObjectivesPanel" style="width: 100%; background-image: url(&quot;project://database/Assets/_Project/UI/Images/HUD/gradient-bg-L.png?fileID=2800000&amp;guid=6f211bfc720385d48a252b1e9f4da74b&amp;type=3#gradient-bg-L&quot;); background-position-x: center; padding-left: 1%; padding-bottom: 1%; padding-top: 1%; border-left-color: rgb(225, 202, 92); border-right-color: rgb(225, 202, 92); border-top-color: rgb(225, 202, 92); border-bottom-color: rgb(225, 202, 92); border-left-width: 5px; display: flex;">
                    <ui:VisualElement name="MainQuestContainer" style="flex-grow: 1; width: 100%; flex-direction: row; align-items: flex-start; margin-top: 8px; min-width: 0;">
                        <ui:Image name="MainQuestIcon" style="background-image: url(&quot;project://database/Assets/_Project/UI/Images/HUD/main-quest-icon.png?fileID=21300000&amp;guid=4333a893a22b52e49b564f884c41bed3&amp;type=3#main-quest-icon&quot;); width: 54px; height: 73px; margin-right: 18px; flex-shrink: 0; -unity-background-image-tint-color: rgb(226, 203, 93); aspect-ratio: auto;"/>
                        <ui:VisualElement name="MainQuestTextContainer" style="flex-grow: 1; width: 0; min-width: 0; padding-right: 10px;">
                            <ui:Label text="THE MAIN QUEST" name="MainQuestTitle" style="font-size: 40%; max-width: 100%; white-space: normal; overflow: hidden; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); color: rgb(255, 255, 255); -unity-font-style: normal; padding-top: 0;"/>
                            <ui:Label text="Details here..." name="MainQuestDescription" style="font-size: 33%; max-width: 100%; white-space: normal; overflow: hidden; text-overflow: clip; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 255, 255);"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ObjectiveTrackingHint" style="flex-direction: row; align-items: center; margin-top: 4px; margin-left: 91px;">
                    <ui:Image name="ObjectiveTrackingKeyIcon" style="width: 34px; height: 34px; flex-shrink: 0; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_v.png?fileID=2800000&amp;guid=b8d7df4f2b5ee844ba2e93858eee8d8b&amp;type=3#keyboard_v&quot;); margin-right: 8px;"/>
                    <ui:Label text="Track current objective" name="ObjectiveTrackingHintLabel" style="font-size: 27%; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgba(255, 255, 255, 0.82);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="BottomCenterPromptHUD" style="position: absolute; left: 50%; bottom: 18%; translate: -50% 0; width: 26%; min-width: 360px; max-width: 520px; flex-direction: column; align-items: stretch; background-image: none; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; border-left-color: rgb(225, 202, 92); border-right-color: rgb(225, 202, 92); border-top-color: rgb(225, 202, 92); border-bottom-color: rgb(225, 202, 92); border-right-width: 5px; display: none; border-left-width: 5px; background-color: rgba(0, 0, 0, 0.2);">
