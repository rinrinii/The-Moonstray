        <ui:VisualElement name="DialogueContainer" class="dialogue-root" style="flex-grow: 1; font-size: 24px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 0; align-items: center; align-self: auto; justify-content: flex-end; width: 100%; height: 100%; padding-bottom: 60px; margin-top: 0; margin-right: 0; margin-left: 0; display: none; background-color: rgba(0, 0, 0, 0.12);">
