                                <ui:Image name="PromptKeyA" style="display: none; width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_a.png?fileID=2800000&amp;guid=d0f500564309d68439ed8a8b4c6cf7c4&amp;type=3#keyboard_a&quot;);"/>
                                <ui:Image name="PromptKeyS" style="display: none; width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_s.png?fileID=2800000&amp;guid=1436c8e79c60d5a488dc2211dc166266&amp;type=3#keyboard_s&quot;);"/>
