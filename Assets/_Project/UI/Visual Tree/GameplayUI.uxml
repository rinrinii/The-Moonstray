                                <ui:Image name="PromptKeyJ" style="display: none; width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_j.png?fileID=2800000&amp;guid=a3bf6326a36172443b7cdbbf405c7a97&amp;type=3#keyboard_j&quot;);"/>
