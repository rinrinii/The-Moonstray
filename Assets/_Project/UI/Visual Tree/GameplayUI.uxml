                        <ui:Image name="MinimapHotkey" style="position: absolute; width: 30px; height: 30px; bottom: -24px; right: -8px; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_m.png?fileID=2800000&amp;guid=2ea4b6926d8feaa41a46397cb4fa4044&amp;type=3#keyboard_m&quot;);"/>
