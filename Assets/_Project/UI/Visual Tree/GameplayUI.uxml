                        <ui:VisualElement name="HealthBarContainer" style="flex-grow: 1; width: 557px; height: 27px; background-color: rgb(51, 51, 51); margin-left: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; overflow: hidden; margin-top: 5px; margin-right: 0; margin-bottom: 10px; align-items: flex-start; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: flex;">
                            <ui:VisualElement name="HealthFill" style="flex-grow: 1; background-color: rgb(69, 137, 69); width: 100%; height: 100%; align-items: stretch; flex-shrink: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="StaminaBarContainer" style="flex-grow: 1; width: 557px; height: 10px; background-color: rgb(51, 51, 51); margin-left: 0; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; overflow: hidden; margin-top: 0; margin-right: 0; margin-bottom: 2px; align-items: flex-start; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: flex;">
