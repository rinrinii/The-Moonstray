                </ui:VisualElement>
                <ui:VisualElement name="TopHealthContainer" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; align-items: center; -unity-text-align: middle-left; overflow: hidden;">
