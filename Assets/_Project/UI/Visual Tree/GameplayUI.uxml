                                <ui:Image name="PromptKeySpace" style="display: none; width: 72px; height: 32px; background-image: url(&quot;project://database/Assets/_Project/UI/Images/keyboard-mouse-icons/keyboard_space.png?fileID=2800000&amp;guid=6ba87a6d238851a4d98cd81dc9b781a6&amp;type=3#keyboard_space&quot;);"/>
