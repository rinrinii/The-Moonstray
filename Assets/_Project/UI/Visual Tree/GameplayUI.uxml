        <ui:VisualElement name="GameOverContainer" style="flex-grow: 1; position: absolute; justify-content: center; top: 0; left: 0; right: 0; bottom: 0; align-items: center; display: none; background-color: rgba(0, 0, 0, 0.86);">
            <ui:VisualElement name="GameOverPanel" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/_Project/UI/Images/PauseMenu/pause-bg.png?fileID=21300000&amp;guid=3351ad37fad340c45ac3a89681fca2cc&amp;type=3#pause-bg&quot;); width: 600px; max-width: 600px; height: 680px;">
                <ui:VisualElement name="TopSection" style="flex-grow: 0; width: 100%; align-items: center; margin-top: 70px; margin-bottom: 40px;">
                    <ui:Label text="You Have Fallen" name="GameOverTitle" style="font-size: 80px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 18%;"/>
                </ui:VisualElement>
