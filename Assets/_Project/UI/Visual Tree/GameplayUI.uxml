                            </ui:VisualElement>
                            <ui:Label text="Movement" name="PromptHeader" style="font-size: 28px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); color: rgb(255, 250, 250);"/>
                        </ui:VisualElement>
                        <ui:Label text="Use WASD to move around." name="PromptBody" style="font-size: 24px; -unity-font-style: normal; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&amp;guid=1c68df65c086c5e4ab7422383dbcf6f7&amp;type=3#AlegreyaSans-Medium&quot;); color: rgb(255, 250, 250);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="BottomLeftHUD" style="flex-grow: 1; position: absolute; left: 40px; bottom: 5px; flex-direction: column; align-items: flex-start; width: auto; height: 20%; min-width: 0%; min-height: 0%; max-width: 40%; max-height: 40%;">
                <ui:VisualElement name="StatusEffectsContainer" style="flex-grow: 1; width: 50%; height: 25%; position: absolute; left: 26.3%; top: 9%; background-image: none; display: flex; flex-direction: row; flex-wrap: wrap;">
