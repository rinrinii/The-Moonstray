                    </ui:GroupBox>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="JournalContainer" style="flex-grow: 1; position: relative; justify-content: center; top: 0; left: 0; right: 0; bottom: 0; align-items: center; display: none; background-color: rgba(0, 0, 0, 0.74);">
            <ui:Image name="journal-bg" style="background-image: url(&quot;project://database/Assets/_Project/UI/Images/Journal/Journal-bg.png?fileID=2800000&amp;guid=ef72858706355754e8d2a0cf6400384e&amp;type=3#Journal-bg&quot;); position: absolute; width: 67%; height: 85%; bottom: 8%;"/>
            <ui:TabView name="TabView" reorderable="false" language-direction="Inherit" style="align-items: flex-start; height: 70%; width: 75%; background-image: none; flex-direction: row; justify-content: space-between; position: absolute; left: 12.4%;">
