<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Stylesheets/UIStyle.uss?fileID=7433441132597879392&amp;guid=5ca3eae8c523ede4fba5c0e3a3a2c1ba&amp;type=3#UIStyle"/>
    <ui:VisualElement name="EndingChoiceContainer" class="ending-choice-root">
        <ui:VisualElement class="ending-choice-panel">
            <ui:Label text="☾" class="ending-choice-moon"/>
            <ui:Label text="THE FINAL CHOICE" class="ending-choice-kicker"/>
            <ui:Label text="What will you do?" name="Header" class="ending-choice-title"/>
            <ui:Label text="The fate of the artifact rests in your hands." class="ending-choice-subtitle"/>
            <ui:VisualElement name="ChoiceContainer" class="ending-choice-options">
                <ui:Button name="RestoreButton" class="ending-choice-option">
                    <ui:Label text="✦  Restore the Artifact" class="ending-choice-option-title"/>
                    <ui:Label text="Reunite the fragments and restore the balance once maintained by Lunaria." class="ending-choice-option-description"/>
                </ui:Button>
                <ui:Button name="DestroyButton" class="ending-choice-option ending-choice-option-destroy">
                    <ui:Label text="✧  Destroy the Artifact" class="ending-choice-option-title"/>
                    <ui:Label text="End the fragments' influence and leave the world's future in its own hands." class="ending-choice-option-description"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Label text="Your choice will determine the ending of the story." class="ending-choice-consequence"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
