<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Stylesheets/UIStyle.uss?fileID=7433441132597879392&amp;guid=5ca3eae8c523ede4fba5c0e3a3a2c1ba&amp;type=3#UIStyle"/>
    <ui:VisualElement name="EndingChoiceContainer" style="flex-grow: 1; width: 100%; height: 100%; flex-wrap: wrap; align-items: center; justify-content: flex-end; padding-top: 10%; padding-bottom: 20%; flex-direction: column;">
        <ui:Label text="What will you do?" name="Header" style="font-size: 120px; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&amp;guid=ef76212c595460c43b2f0f7f020c38d2&amp;type=3#solander demo&quot;); color: rgb(255, 255, 255); -unity-text-align: middle-center; margin-bottom: 20%; justify-content: center; align-items: center; align-self: center;"/>
        <ui:VisualElement name="ChoiceContainer" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-left;">
            <ui:Button text="Restore Artifact&#10;" name="RestoreButton" class="button" style="width: 80%; height: 15%; margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 10%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 20%; font-size: 70%;"/>
            <ui:Button text="DESTROY ARTIFACT&#10;" name="DestroyButton" class="button" style="width: 80%; height: 15%; margin-top: 2%; margin-right: 0%; margin-bottom: 2%; margin-left: 10%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 20%; font-size: 70%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
