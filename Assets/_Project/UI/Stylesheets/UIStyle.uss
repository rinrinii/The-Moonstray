:root {
}

.header {
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Quicksand/Quicksand-Regular.ttf?fileID=12800000&guid=42c3b3180726c754d92ed9a1f6c5a726&type=3#Quicksand-Regular");
    font-size: 40px;
}

.button {
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&guid=ef76212c595460c43b2f0f7f020c38d2&type=3#solander demo");
    color: rgb(255, 255, 255);
    font-size: 400%;
    width: 300px;
    height: 88px;
    justify-content: center;
    align-items: flex-start;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-bottom: 0;
    margin-top: 10px;
    align-self: auto;
    -unity-text-align: middle-left;
    text-shadow: 0 0 0 rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    background-position-x: left 0;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.button:hover {
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/_Project/UI/Images/button-bg.png?fileID=2800000&guid=2464c6cc2deb8d443adbacee7273e331&type=3#button-bg");
    background-position-x: left 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    text-shadow: 0 0 60px rgba(255, 255, 255, 0.4);
    transition-property: all;
    transition-duration: 0s;
    opacity: 1;
    font-size: 14%;
    padding-left: 60px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    justify-content: center;
}

.button2 {
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&guid=ef76212c595460c43b2f0f7f020c38d2&type=3#solander demo");
    font-size: 405%;
}

.label1 {
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Quicksand/Quicksand-Medium.ttf?fileID=12800000&guid=c75ef448adfa7da4a9b656cf84b413c5&type=3#Quicksand-Medium");
    color: rgb(255, 255, 255);
    font-size: 25px;
    -unity-text-align: lower-right;
    -unity-font-style: normal;
}

.slider {
    width: 80%;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/AlegreyaSans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=1c68df65c086c5e4ab7422383dbcf6f7&type=3#AlegreyaSans-Medium");
    font-size: 47%;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-auto-size: none;
}

.ItemSlot {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(209, 162, 74);
    border-right-color: rgb(209, 162, 74);
    border-top-color: rgb(209, 162, 74);
    border-bottom-color: rgb(209, 162, 74);
    max-width: 120px;
    max-height: 120px;
    width: 120px;
    height: 120px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.ItemPlaceholder {
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    background-color: rgba(0, 0, 0, 0.24);
    width: 120px;
    height: 120px;
    max-height: 120px;
    max-width: 120px;
}

.unity-toggle__checkmark {
    height: 50px;
    width: 50px;
}
.save-slot {
    width: 100%; height: 29%; margin-bottom: 1%; padding: 10px 30px 10px 58px;
    flex-direction: row; align-items: center; background-image: url("project://database/Assets/_Project/UI/Images/Dialogue/dialogue-BG.png?fileID=2800000&guid=bfb0cd7994f70614fa16dcca80ab5c93&type=3#dialogue-BG");
    color: white; font-size: 25px; -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Quicksand/Quicksand-SemiBold.ttf?fileID=12800000&guid=35f65dbe7a372414796dfd6f32de3838&type=3#Quicksand-SemiBold");
    background-color: rgba(0,0,0,0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.12s;
}
.save-slot:hover { background-color: rgba(0,0,0,0); -unity-background-image-tint-color: rgb(255,240,170); scale: 1.01 1.01; }
.save-slot:active { scale: 0.995 0.995; -unity-background-image-tint-color: rgb(255,215,105); }
.save-slot:disabled { opacity: 0.48; }
.save-slot-thumbnail { height: 90%; aspect-ratio: 1.7778; margin-right: 24px; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; background-color: rgba(75,80,93,0.7); }
.save-slot-details { flex-grow: 1; height: 90%; justify-content: space-between; }
.save-slot-title { color: rgb(238,202,92); font-size: 34px; }
.save-slot-time { -unity-font-style: italic; }
.save-confirmation-blocker {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.68);
}
.save-confirmation-dialog {
    width: 48%; min-height: 260px; padding: 42px 55px;
    align-items: center; justify-content: space-between;
    background-image: url("project://database/Assets/_Project/UI/Images/Dialogue/dialogue-BG.png?fileID=2800000&guid=bfb0cd7994f70614fa16dcca80ab5c93&type=3#dialogue-BG");
    -unity-background-scale-mode: stretch-to-fill;
    color: white; font-size: 26px; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Quicksand/Quicksand-SemiBold.ttf?fileID=12800000&guid=35f65dbe7a372414796dfd6f32de3838&type=3#Quicksand-SemiBold");
}
.save-confirmation-title {
    color: rgb(238, 202, 92); font-size: 46px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Solander/solander%20demo.ttf?fileID=12800000&guid=ef76212c595460c43b2f0f7f020c38d2&type=3#solander demo");
}
.save-confirmation-actions { flex-direction: row; justify-content: center; }
.save-confirmation-button {
    min-width: 190px; height: 58px; margin-left: 12px; margin-right: 12px;
    color: white; font-size: 25px; background-color: rgba(0, 13, 38, 0.9);
    border-left-color: rgb(238, 202, 92); border-right-color: rgb(238, 202, 92);
    border-top-color: rgb(238, 202, 92); border-bottom-color: rgb(238, 202, 92);
}
.save-confirmation-button:hover { color: rgb(255, 225, 115); background-color: rgba(15, 35, 68, 0.95); }
