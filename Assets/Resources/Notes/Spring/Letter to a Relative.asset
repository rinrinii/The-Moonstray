  m_Script: {fileID: 11500000, guid: a20105d88834d764380d6090e8c10179, type: 3}
  m_Name: Letter to a Relative
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Letter to a Relative
  content: "Dear Clara,\n\nI hope this letter reaches you before the trade caravans
    stop for the season.\nLily talks about Frostmere every chance she gets. She carries
    that little field guide everywhere, asking questions neither Elian nor I can
    answer.\nHer teacher says she's the brightest student they've had in years. Imagine
    that.\nWe don't know if we'll ever have enough to send her there, but Elian keeps
    saying we'll find a way somehow.\nIt would be a shame if such curiosity never
    had the chance to grow.\n\nGive everyone our love.\n\n\u2014 Hellen\n\nCourier:
    O. Pike"
