  m_Script: {fileID: 11500000, guid: a20105d88834d764380d6090e8c10179, type: 3}
  m_Name: Lunch Break Notice
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Lunch Break Notice
  content: "To Whoever Keeps Taking My Lunch\n\nThis is the third time someone has
    stolen my sandwich.\nIf you're hungry, ask.\nIf you're curious whether engine
    grease improves the flavor... It doesn't.\n\u2014 Tessa\n\n(Someone scribbled
    underneath.)\n\"It was probably Felix.\"\n\n(Another handwriting.)\n\"IT WAS
    NOT.\"\n\u2014 Felix"
