  m_Script: {fileID: 11500000, guid: a20105d88834d764380d6090e8c10179, type: 3}
  m_Name: Letter from the Northern Expedition
  m_EditorClassIdentifier: Assembly-CSharp::NoteData
  title: Letter from the Northern Expedition
  content: "To the Archivists of Frostmere,\nWe have reached the northern pass, though
    visibility continues to worsen.\nThe fog muffles every sound. Even our own footsteps
    seem distant.\nWe rely on the signal horn to keep the group together, but each
    call grows quieter than the last.\nIf this letter reaches you and we do not...
    Do not send another expedition.\nSome paths are not meant to be crossed.\n\u2014
    Expedition Leader (the name seems to have been scratched out.)"
